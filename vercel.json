{
  "redirects": [
    { "source": "/ru", "destination": "/", "permanent": true },
    { "source": "/ru/:path*", "destination": "/", "permanent": true },
    { "source": "/uk", "destination": "/", "permanent": true },
    { "source": "/uk/:path*", "destination": "/", "permanent": true },
    { "source": "/ua", "destination": "/", "permanent": true },
    { "source": "/ua/:path*", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*\\.(?:css|js|woff2|webp|svg|png|jpg))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
